{
  "name": "pi-todo-gate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run architecture && vitest run",
    "architecture": "depcruise --config .dependency-cruiser.cjs src extensions test",
    "typecheck": "tsc --noEmit",
    "lint:biome": "biome check extensions src test",
    "lint:strict": "tsx src/lint-cli.ts",
    "lint": "npm run lint:biome && npm run lint:strict",
    "install-local": "bash install.sh",
    "configure": "bash install.sh configure",
    "prepare": "git config core.hooksPath .githooks"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "todoist",
    "git"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@earendil-works/pi-ai": "^0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@types/node": "^25.0.0",
    "dependency-cruiser": "^17.4.3",
    "tsx": "^4.23.13",
    "typebox": "^1.1.34",
    "typescript": "^6.0.0",
    "vitest": "^4.1.5"
  },
  "pi": {
    "extensions": [
      "./extensions/pi-todo-gate.ts"
    ]
  }
}
